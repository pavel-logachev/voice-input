<Window x:Class="VoiceInput.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceInput.App"
        Title="Voice Input"
        Icon="pack://application:,,,/VoiceInput.ico"
        Width="286"
        MinHeight="72"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border x:Name="Frame"
            Padding="12,10"
            CornerRadius="14"
            Background="#F20E1016"
            BorderBrush="#38FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.34"
                              ShadowDepth="6"
                              Color="#03050A" />
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- State light: a ring with a lens, coloured by the dictation stage. -->
            <Border x:Name="TallyRing"
                    Grid.Row="0"
                    Grid.Column="0"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="9"
                    BorderBrush="#66FF756D"
                    BorderThickness="1">
                <Ellipse x:Name="TallyLens"
                         Width="8"
                         Height="8"
                         Fill="#FF756D" />
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="0"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#FAFAFC"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="Voice Input" />

            <Border x:Name="CancelHint"
                    Grid.Row="0"
                    Grid.Column="2"
                    Width="32"
                    Height="22"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#141E2230"
                    BorderBrush="#4AFFFFFF"
                    BorderThickness="1"
                    CornerRadius="5">
                <TextBlock x:Name="CancelKeyText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#C9CCD6"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="Esc" />
            </Border>

            <Grid x:Name="ActivityHost"
                  Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Height="14"
                  Margin="0,7,0,0"
                  HorizontalAlignment="Stretch">
                <local:RecordingLevelMeter x:Name="AudioMeter"
                                           Height="14"
                                           HorizontalAlignment="Stretch"
                                           ClipToBounds="True" />
                <Grid x:Name="ProcessingIndicator"
                      Height="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      Visibility="Collapsed">
                    <Border x:Name="ProcessingTrack"
                            Height="2"
                            VerticalAlignment="Center"
                            Background="#3F565B6B"
                            CornerRadius="1" />
                    <Rectangle x:Name="ProcessingCue"
                               Width="44"
                               Height="2"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               RadiusX="1"
                               RadiusY="1"
                               Fill="#A99BFF">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-44" />
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-44"
                                                         To="230"
                                                         Duration="0:0:0.9"
                                                         AccelerationRatio="0.14"
                                                         DecelerationRatio="0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Grid>
            </Grid>

            <TextBlock x:Name="DetailText"
                       Grid.Row="2"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       MaxWidth="232"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Left"
                       TextAlignment="Left"
                       TextWrapping="Wrap"
                       Foreground="#B7BBC7"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11"
                       LineHeight="16"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
