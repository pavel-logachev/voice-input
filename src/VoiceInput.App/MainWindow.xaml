<Window x:Class="VoiceInput.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VoiceInput.App"
        Title="Voice Input"
        Width="200"
        MinHeight="64"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False">
    <Border x:Name="Frame"
            Padding="14,10"
            CornerRadius="12"
            Background="#F20B1220"
            BorderBrush="#2B3A50"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16"
                              Direction="270"
                              Opacity="0.35"
                              ShadowDepth="4"
                              Color="#020617" />
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText"
                       Grid.Row="0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Foreground="#F8FAFC"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Text="Voice Input" />
            <Grid x:Name="ActivityHost"
                  Grid.Row="1"
                  Height="12"
                  Margin="0,7,0,0">
                <local:RecordingLevelMeter x:Name="AudioMeter"
                                           Width="140"
                                           Height="12"
                                           HorizontalAlignment="Center"
                                           ClipToBounds="True" />
                <Grid x:Name="ProcessingIndicator"
                      Width="140"
                      Height="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      ClipToBounds="True"
                      Visibility="Collapsed">
                    <Border Background="#334155" CornerRadius="2" />
                    <Rectangle Width="32"
                               Height="4"
                               HorizontalAlignment="Left"
                               RadiusX="2"
                               RadiusY="2"
                               Fill="#A78BFA">
                        <Rectangle.RenderTransform>
                            <TranslateTransform X="-32" />
                        </Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-32"
                                                         To="140"
                                                         Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Grid>
            </Grid>
            <TextBlock x:Name="DetailText"
                       Grid.Row="2"
                       MaxWidth="172"
                       Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#94A3B8"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>
