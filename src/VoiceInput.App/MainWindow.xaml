<Window x:Class="VoiceInput.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Input"
        Width="360"
        Height="92"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False">
    <Border x:Name="Frame"
            Padding="18,14"
            CornerRadius="16"
            Background="#F20B1220"
            BorderBrush="#334155"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.45"
                              ShadowDepth="8"
                              Color="#020617" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot"
                     Width="12"
                     Height="12"
                     Margin="0,0,14,0"
                     VerticalAlignment="Center"
                     Fill="#22D3EE" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="#F8FAFC"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Voice Input" />
                <TextBlock x:Name="DetailText"
                           Margin="0,4,0,0"
                           Foreground="#94A3B8"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           Text="Ctrl + Shift + Space" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
