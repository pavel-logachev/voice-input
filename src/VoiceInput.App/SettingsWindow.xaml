<Window x:Class="VoiceInput.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Input — настройки"
        Icon="pack://application:,,,/VoiceInput.ico"
        Width="480"
        SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Keyboard focus: one ring for every control. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource Brush.Focus}"
                                BorderThickness="2"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- For a row that fills its card: the ring stays inside the card. -->
        <Style x:Key="InsetFocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="4"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource Brush.Focus}"
                                BorderThickness="2"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.Divider}" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Buttons: secondary by default, primary for the one main action, link for quiet navigation. -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="{DynamicResource Brush.Subtle}"
                                BorderBrush="{DynamicResource Brush.FieldBorder}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FieldBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
                            </Trigger>
                            <!-- Inactive: an outline only, so the label keeps its contrast. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="{DynamicResource Brush.Accent}"
                                BorderBrush="{DynamicResource Brush.Accent}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.AccentPressed}" />
                            </Trigger>
                            <!-- Inactive is plainly inactive, not a washed-out accent. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextFaint}" />
                                <Setter Property="FontWeight" Value="Normal" />
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Brush.FieldBorder}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="2,3">
                            <TextBlock x:Name="Label"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The API key field. -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Frame"
                                CornerRadius="8"
                                Background="{DynamicResource Brush.Field}"
                                BorderBrush="{DynamicResource Brush.FieldBorder}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.FieldBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drop-down list. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Path x:Name="Tick"
                                      Grid.Column="1"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Data="M0,4.2 L3.4,7.6 L9.4,0.8"
                                      Stroke="{DynamicResource Brush.Accent}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Hidden" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Highlight}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.OnHighlight}" />
                                <Setter TargetName="Tick" Property="Stroke" Value="{DynamicResource Brush.OnHighlight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Frame"
                                    Background="{DynamicResource Brush.Field}"
                                    BorderBrush="{DynamicResource Brush.FieldBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8" />
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,1,13,0"
                                  Data="M0,0 L4,4.4 L8,0"
                                  Stroke="{DynamicResource Brush.TextMuted}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                            <!-- The whole field opens the list; the frame above shows the state. -->
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,32,1"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   HorizontalOffset="-8"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="8,4,8,12"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxWidth="380"
                                        MaxHeight="260"
                                        Padding="4"
                                        Background="{DynamicResource Brush.Card}"
                                        BorderBrush="{DynamicResource Brush.FieldBorder}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.FieldBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A whole settings row that switches: the label on the left, the switch on the right. -->
        <Style x:Key="SwitchRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource InsetFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Border x:Name="Track"
                                    Width="38"
                                    Height="20"
                                    Margin="0,0,14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="10"
                                    Background="{DynamicResource Brush.Field}"
                                    BorderBrush="{DynamicResource Brush.FieldBorderHover}"
                                    BorderThickness="1">
                                <Ellipse x:Name="Knob"
                                         Width="10"
                                         Height="10"
                                         Margin="4,0"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource Brush.TextMuted}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Width" Value="12" />
                                <Setter TargetName="Knob" Property="Height" Value="12" />
                                <Setter TargetName="Knob" Property="Margin" Value="3,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One engine of three: a whole card row with a round mark, its name and what it means. -->
        <Style x:Key="EngineOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource InsetFocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" Margin="14,10,12,0" VerticalAlignment="Top">
                                <Ellipse x:Name="Ring"
                                         Fill="{DynamicResource Brush.Field}"
                                         Stroke="{DynamicResource Brush.FieldBorderHover}"
                                         StrokeThickness="1.5" />
                                <Ellipse x:Name="Mark"
                                         Width="7"
                                         Height="7"
                                         Fill="{DynamicResource Brush.OnAccent}"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="0,9,14,10" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text fields of the own server: the same frame as the key field, and a red one while the value is wrong. -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame"
                                CornerRadius="8"
                                Background="{DynamicResource Brush.Field}"
                                BorderBrush="{DynamicResource Brush.FieldBorder}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.FieldBorderHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Error">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Error}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The confirming button of a destructive action. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="{DynamicResource Brush.Error}"
                                BorderBrush="{DynamicResource Brush.Error}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.76" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Download progress of the local model: a thin track, filled with the accent. -->
        <Style x:Key="ModelProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track"
                                    CornerRadius="3"
                                    Background="{DynamicResource Brush.Subtle}"
                                    BorderBrush="{DynamicResource Brush.CardBorder}"
                                    BorderThickness="1" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="3"
                                    Background="{DynamicResource Brush.Accent}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The heading line of an engine's own settings, under the three choices. -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- A coloured dot in front of a state line, so the state reads at a glance and in high contrast. -->
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="1,6,8,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <!-- A keyboard key cap: the same one the overlay shows for Esc. -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.KeyCap}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.KeyCapBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.KeyCapText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="HotkeyLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A thin scroll bar for displays the window does not fit. -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Width="10">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Margin="3,2" CornerRadius="2" Background="{DynamicResource Brush.FieldBorderHover}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="ContentPanel" Margin="20,14,20,16">
            <!-- Header -->
            <Grid Margin="2,0,2,13">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="HeaderIcon"
                       Width="36"
                       Height="36"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Voice Input" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText"
                                   Margin="8,0,0,1"
                                   VerticalAlignment="Bottom"
                                   Foreground="{DynamicResource Brush.TextFaint}"
                                   FontSize="12" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Говорите — текст появится там, где стоит курсор" />
                </StackPanel>
            </Grid>

            <!-- Recognition engine: three choices, then the settings of the chosen one. -->
            <TextBlock x:Name="EngineCaption" Style="{StaticResource SectionCaption}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel x:Name="EngineOptions" KeyboardNavigation.DirectionalNavigation="Contained">
                        <RadioButton x:Name="OpenAiRadio" GroupName="Engine" Style="{StaticResource EngineOption}">
                            <StackPanel>
                                <TextBlock x:Name="OpenAiTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="OpenAiDescription" Style="{StaticResource Hint}" FontWeight="Normal" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <Border Style="{StaticResource RowDivider}" Margin="44,0,0,0" />
                        <RadioButton x:Name="LocalRadio" GroupName="Engine" Style="{StaticResource EngineOption}">
                            <StackPanel>
                                <TextBlock x:Name="LocalTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="LocalDescription" Style="{StaticResource Hint}" FontWeight="Normal" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <Border x:Name="CustomDivider" Style="{StaticResource RowDivider}" Margin="44,0,0,0" />
                        <RadioButton x:Name="CustomRadio" GroupName="Engine" Style="{StaticResource EngineOption}">
                            <StackPanel>
                                <TextBlock x:Name="CustomTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="CustomDescription" Style="{StaticResource Hint}" FontWeight="Normal" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <Border Style="{StaticResource RowDivider}" Margin="0" />

                    <!-- OpenAI: the API key, exactly as before. -->
                    <StackPanel x:Name="KeyCard" Margin="14,12,14,14">
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="KeyCaption" Style="{StaticResource PanelTitle}" Text="API-ключ OpenAI" />
                            <Border x:Name="KeyChip"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="8,1,9,2"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="KeyChipDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    <TextBlock x:Name="KeyChipText" Margin="6,0,0,0" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="KeyState" Style="{StaticResource Hint}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KeyBox" AutomationProperties.LabeledBy="{Binding ElementName=KeyCaption}" />
                            <TextBlock x:Name="KeyPlaceholder"
                                       Margin="12,0,0,1"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Brush.TextFaint}"
                                       Text="sk-…" />
                            <Button x:Name="SaveKeyButton"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="Сохранить" />
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CheckKeyButton" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Content="Проверить" />
                            <Button x:Name="DeleteKeyButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Content="Удалить ключ" />
                            <TextBlock x:Name="KeyResult"
                                       Grid.Column="2"
                                       Style="{StaticResource Hint}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>

                    <!-- On this computer: the model card. -->
                    <Grid x:Name="LocalPanel" Margin="14,12,14,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LocalModelName" Style="{StaticResource PanelTitle}" Margin="0,0,12,0" />
                        <Button x:Name="LocalActionButton"
                                Grid.Column="1"
                                MinWidth="104"
                                Style="{StaticResource SecondaryButton}" />
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="LocalStateDot" Style="{StaticResource StateDot}" />
                            <TextBlock x:Name="LocalState"
                                       Grid.Column="1"
                                       Style="{StaticResource Hint}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <ProgressBar x:Name="LocalProgress"
                                     Grid.Row="2"
                                     Grid.ColumnSpan="2"
                                     Margin="0,10,0,2"
                                     Style="{StaticResource ModelProgress}"
                                     AutomationProperties.LabeledBy="{Binding ElementName=LocalState}" />
                        <TextBlock x:Name="LocalPrivacy" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </Grid>

                    <!-- Own server: address, model, optional key and a check. -->
                    <StackPanel x:Name="CustomPanel" Margin="14,12,14,14">
                        <TextBlock x:Name="CustomUrlLabel" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="CustomUrlBox" AutomationProperties.LabeledBy="{Binding ElementName=CustomUrlLabel}" />
                        <TextBlock x:Name="CustomUrlNote" Style="{StaticResource Hint}" Margin="0,5,0,0" />

                        <TextBlock x:Name="CustomModelLabel" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
                        <TextBox x:Name="CustomModelBox" AutomationProperties.LabeledBy="{Binding ElementName=CustomModelLabel}" />
                        <TextBlock x:Name="CustomModelNote" Style="{StaticResource Hint}" Margin="0,5,0,0" />

                        <Grid Margin="0,10,0,6">
                            <TextBlock x:Name="CustomKeyLabel" VerticalAlignment="Center" />
                            <Border x:Name="CustomKeyChip"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="8,1,9,2"
                                    CornerRadius="10">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="CustomKeyChipDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    <TextBlock x:Name="CustomKeyChipText" Margin="6,0,0,0" FontSize="11.5" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="CustomKeyBox" AutomationProperties.LabeledBy="{Binding ElementName=CustomKeyLabel}" />
                            <Button x:Name="CustomKeySaveButton" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" />
                            <Button x:Name="CustomKeyDeleteButton" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <TextBlock x:Name="CustomKeyNote" Style="{StaticResource Hint}" Margin="0,5,0,0" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="CustomCheckButton" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="CustomCheckResult"
                                       Grid.Column="1"
                                       Style="{StaticResource Hint}"
                                       Margin="12,0,0,0"
                                       Padding="0,6,0,0"
                                       AutomationProperties.LiveSetting="Polite"
                                       Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="CustomPrivacy" Style="{StaticResource Hint}" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Recognition -->
            <TextBlock Style="{StaticResource SectionCaption}" Text="Распознавание" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="14,0" MinHeight="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="236" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Text="Язык речи" />
                        <ComboBox x:Name="LanguageBox" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" />
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <Grid Margin="14,0" MinHeight="54">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="236" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="MicrophoneLabel" Text="Микрофон" />
                            <TextBlock Style="{StaticResource Hint}" Text="Со следующей записи" />
                        </StackPanel>
                        <ComboBox x:Name="MicrophoneBox" Grid.Column="1" AutomationProperties.LabeledBy="{Binding ElementName=MicrophoneLabel}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Hotkeys and startup -->
            <TextBlock Style="{StaticResource SectionCaption}" Text="Клавиши и запуск" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="14,8,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="26" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource HotkeyLabel}" Text="Удерживать для записи" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl" /></Border>
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Shift" /></Border>
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Space" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource HotkeyLabel}" Text="Начать и закончить без удержания" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl" /></Border>
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Shift" /></Border>
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="K" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource HotkeyLabel}" Text="Отменить диктовку" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Esc" /></Border>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource RowDivider}" />
                    <CheckBox x:Name="AutostartBox" Style="{StaticResource SwitchRow}" Content="Запускать вместе с Windows" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Message"
                       Margin="2,-4,2,8"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Visibility="Collapsed" />

            <Grid Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SiteButton" Style="{StaticResource LinkButton}" Content="GitHub" />
                    <Button x:Name="IssueButton" Margin="12,0,0,0" Style="{StaticResource LinkButton}" Content="Сообщить о проблеме" />
                </StackPanel>
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        MinWidth="88"
                        Style="{StaticResource SecondaryButton}"
                        IsDefault="True"
                        IsCancel="True"
                        Content="Готово" />
            </Grid>
        </StackPanel>
    </ScrollViewer>

    <!-- Confirmation of the model deletion: a dialog over the dimmed window, like a Windows content dialog. -->
    <Grid x:Name="ConfirmLayer" Visibility="Collapsed" Background="Transparent">
        <Border x:Name="ConfirmCard"
                Style="{StaticResource Card}"
                Margin="32,0"
                MaxWidth="400"
                Padding="20,18,20,18"
                VerticalAlignment="Center"
                AutomationProperties.LabeledBy="{Binding ElementName=ConfirmTitle}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="ConfirmTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="ConfirmText"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           LineHeight="19"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button x:Name="ConfirmDeleteButton" MinWidth="96" Style="{StaticResource DangerButton}" />
                    <Button x:Name="ConfirmCancelButton" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
