<Window x:Class="VoiceInput.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Input — настройки"
        Icon="pack://application:,,,/VoiceInput.ico"
        Width="460"
        SizeToContent="Height"
        MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0E1016"
        Foreground="#FAFAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9EA3B3" />
        <SolidColorBrush x:Key="Line" Color="#2A2D3A" />
        <SolidColorBrush x:Key="Accent" Color="#A99BFF" />

        <!-- A selectable card used for the two engines. -->
        <Style x:Key="EngineCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Padding="14,11"
                                CornerRadius="10"
                                Background="#141722"
                                BorderBrush="#2A2D3A"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Ring"
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0"
                                        CornerRadius="8"
                                        BorderBrush="#5A5F73"
                                        BorderThickness="1.5">
                                    <Ellipse x:Name="Dot"
                                             Width="8"
                                             Height="8"
                                             Fill="#A99BFF"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A99BFF" />
                                <Setter TargetName="Card" Property="Background" Value="#1A1C2C" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#A99BFF" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#454A63" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="#141722"
                                    BorderBrush="#5A5F73"
                                    BorderThickness="1.5">
                                <Path x:Name="Tick"
                                      Data="M3.5,9 L7.5,13 L14.5,5"
                                      Stroke="#0E1016"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#A99BFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A99BFF" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A99BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="#232738"
                                BorderBrush="#3A3F55"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2D3248" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="22,20,22,18">
        <TextBlock Text="Распознавание речи" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="EngineIntro"
                   Margin="0,3,0,12"
                   Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap"
                   Text="Выберите, где речь превращается в текст. Переключение действует сразу." />

        <RadioButton x:Name="OpenAiRadio" GroupName="Engine" Style="{StaticResource EngineCard}">
            <StackPanel>
                <TextBlock Text="OpenAI, через интернет" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="Быстро и точно. Запись отправляется в OpenAI по вашему API-ключу, платит владелец ключа." />
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="LocalRadio" GroupName="Engine" Style="{StaticResource EngineCard}">
            <StackPanel>
                <TextBlock Text="На этом компьютере (GigaAM)" FontWeight="SemiBold" />
                <TextBlock Margin="0,2,0,0"
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="Без интернета и без ключа, запись не покидает компьютер. При первом включении загружается модель." />
            </StackPanel>
        </RadioButton>

        <Border Height="1" Margin="0,10,0,14" Background="{StaticResource Line}" />

        <TextBlock Text="API-ключ OpenAI" FontSize="15" FontWeight="SemiBold" />
        <TextBlock x:Name="KeyState"
                   Margin="0,3,0,8"
                   Foreground="{StaticResource Muted}"
                   TextWrapping="Wrap" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="KeyBox"
                         Padding="10,8"
                         Background="#141722"
                         Foreground="#FAFAFC"
                         CaretBrush="#FAFAFC"
                         BorderBrush="#3A3F55"
                         BorderThickness="1" />
            <Button x:Name="SaveKeyButton"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource QuietButton}"
                    Content="Сохранить" />
        </Grid>
        <Button x:Name="DeleteKeyButton"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource QuietButton}"
                Padding="12,5"
                Content="Удалить ключ" />
        <TextBlock Margin="0,8,0,0"
                   Foreground="{StaticResource Muted}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Text="Ключ хранится зашифрованным и доступен только вашей учётной записи Windows на этом компьютере." />

        <Border Height="1" Margin="0,16,0,14" Background="{StaticResource Line}" />

        <CheckBox x:Name="AutostartBox"
                  Foreground="#FAFAFC"
                  Content="Запускать вместе с Windows" />

        <TextBlock x:Name="Message"
                   Margin="0,12,0,0"
                   MinHeight="18"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource Accent}" />

        <Grid Margin="0,10,0,0">
            <TextBlock x:Name="VersionText"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}"
                       FontSize="11" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Style="{StaticResource QuietButton}"
                    IsDefault="True"
                    Content="Готово" />
        </Grid>
    </StackPanel>
</Window>
