<Window x:Class="VoiceInput.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Voice Input — настройки"
        Icon="pack://application:,,,/VoiceInput.ico"
        Width="500"
        SizeToContent="Height"
        MinHeight="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C14"
        Foreground="#FAFAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9EA3B3" />
        <SolidColorBrush x:Key="Faint" Color="#6F7488" />
        <SolidColorBrush x:Key="Accent" Color="#A99BFF" />
        <SolidColorBrush x:Key="CardBackground" Color="#12141F" />
        <SolidColorBrush x:Key="CardBorder" Color="#22263A" />
        <SolidColorBrush x:Key="Field" Color="#0D0F18" />
        <SolidColorBrush x:Key="FieldBorder" Color="#343954" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A selectable card for each recognition engine (shown only when more than one is available). -->
        <Style x:Key="EngineCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card"
                                Padding="14,11"
                                CornerRadius="10"
                                Background="#0D0F18"
                                BorderBrush="#2A2D3A"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Ring"
                                        Width="16"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="0,2,0,0"
                                        CornerRadius="8"
                                        BorderBrush="#5A5F73"
                                        BorderThickness="1.5">
                                    <Ellipse x:Name="Dot"
                                             Width="8"
                                             Height="8"
                                             Fill="#A99BFF"
                                             Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter Grid.Column="1" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#A99BFF" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="#A99BFF" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#454A63" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="5"
                                    Background="#0D0F18"
                                    BorderBrush="#5A5F73"
                                    BorderThickness="1.5">
                                <Path x:Name="Tick"
                                      Data="M3.5,9 L7.5,13 L14.5,5"
                                      Stroke="#0E1016"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#A99BFF" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A99BFF" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#A99BFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="#1E2234"
                                BorderBrush="#343954"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#282D45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Foreground" Value="#0E1016" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Background="#A99BFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#BBB0FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quiet text link. -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                <Setter TargetName="Label" Property="Foreground" Value="#FAFAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark drop-down list. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#262B43" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2D3354" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FAFAFC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Frame"
                                                Background="{StaticResource Field}"
                                                BorderBrush="{StaticResource FieldBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M0,0 L4.5,5 L9,0"
                                                  Stroke="#9EA3B3"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="#A99BFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="#A99BFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,8,34,8"
                                              IsHitTestVisible="False"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Margin="0,4,0,8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260"
                                        Padding="4"
                                        Background="#171A28"
                                        BorderBrush="#343954"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.5" Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A keyboard key cap. -->
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#1A1D2D" />
            <Setter Property="BorderBrush" Value="#3B4060" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#D6D8E4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,20,22,16">
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="44"
                       Height="44"
                       Source="pack://application:,,,/VoiceInput.ico"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Voice Input" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Text="Говорите, текст появится там, где стоит курсор" />
                </StackPanel>
                <Border Grid.Column="2"
                        VerticalAlignment="Center"
                        Padding="9,3"
                        CornerRadius="10"
                        Background="#1A1D2D"
                        BorderBrush="#2E3350"
                        BorderThickness="1">
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="11.5" />
                </Border>
            </Grid>

            <!-- Recognition -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Речь и звук" />
                    <TextBlock x:Name="EngineIntro"
                               Style="{StaticResource Hint}"
                               Margin="0,3,0,10"
                               Text="Выберите, где речь превращается в текст. Переключение действует сразу." />
                    <RadioButton x:Name="OpenAiRadio" GroupName="Engine" Style="{StaticResource EngineCard}">
                        <StackPanel>
                            <TextBlock Text="OpenAI, через интернет" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,2,0,0"
                                       Text="Быстро и точно. Запись отправляется в OpenAI по вашему API-ключу, платит владелец ключа." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LocalRadio" GroupName="Engine" Style="{StaticResource EngineCard}">
                        <StackPanel>
                            <TextBlock Text="На этом компьютере (GigaAM)" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Margin="0,2,0,0"
                                       Text="Без интернета и без ключа, запись не покидает компьютер. При первом включении загружается модель." />
                        </StackPanel>
                    </RadioButton>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6" Text="Язык речи" />
                    <ComboBox x:Name="LanguageBox" Height="36" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,6" Text="Микрофон (применяется со следующей записи)" />
                    <ComboBox x:Name="MicrophoneBox" Height="36" />
                </StackPanel>
            </Border>

            <!-- API key -->
            <Border x:Name="KeyCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="API-ключ OpenAI" />
                        <Border x:Name="KeyChip"
                                HorizontalAlignment="Right"
                                Padding="9,2"
                                CornerRadius="10"
                                Background="#143025">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="KeyChipDot" Width="7" Height="7" Fill="#69D6A4" VerticalAlignment="Center" />
                                <TextBlock x:Name="KeyChipText"
                                           Margin="6,0,0,0"
                                           FontSize="11.5"
                                           Foreground="#9DE6C4"
                                           Text="Ключ сохранён" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="KeyState" Style="{StaticResource Hint}" Margin="0,5,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="KeyBox"
                                     Height="36"
                                     Padding="12,7"
                                     VerticalContentAlignment="Center"
                                     Background="{StaticResource Field}"
                                     Foreground="#FAFAFC"
                                     CaretBrush="#FAFAFC"
                                     BorderBrush="{StaticResource FieldBorder}"
                                     BorderThickness="1" />
                        <Button x:Name="SaveKeyButton"
                                Grid.Column="1"
                                Height="36"
                                Margin="8,0,0,0"
                                Style="{StaticResource PrimaryButton}"
                                Content="Сохранить" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="CheckKeyButton" Style="{StaticResource QuietButton}" Padding="12,5" Content="Проверить" />
                        <Button x:Name="DeleteKeyButton" Margin="8,0,0,0" Style="{StaticResource QuietButton}" Padding="12,5" Content="Удалить ключ" />
                    </StackPanel>
                    <TextBlock x:Name="KeyResult" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,6,0,0"
                               Foreground="{StaticResource Faint}"
                               Text="Ключ хранится зашифрованным и доступен только вашей учётной записи Windows на этом компьютере." />
                </StackPanel>
            </Border>

            <!-- Hotkeys and startup -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Горячие клавиши" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,8" Text="Удерживать для записи" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl" /></Border>
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Shift" /></Border>
                            <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Style="{StaticResource KeyText}" Text="Space" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,0,8" Text="Начать и закончить без удержания" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Ctrl" /></Border>
                            <Border Style="{StaticResource KeyCap}"><TextBlock Style="{StaticResource KeyText}" Text="Shift" /></Border>
                            <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Style="{StaticResource KeyText}" Text="K" /></Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Отменить диктовку" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Style="{StaticResource KeyText}" Text="Esc" /></Border>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Margin="0,14,0,12" Background="{StaticResource CardBorder}" />
                    <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="Message"
                       Margin="2,0,0,6"
                       MinHeight="18"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource Accent}" />

            <Grid Margin="2,4,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SiteButton" Style="{StaticResource LinkButton}" Content="GitHub" />
                    <Button x:Name="IssueButton" Margin="16,0,0,0" Style="{StaticResource LinkButton}" Content="Сообщить о проблеме" />
                </StackPanel>
                <Button x:Name="CloseButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource QuietButton}"
                        IsDefault="True"
                        Content="Готово" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
